__pycache__/
*.pyc
.venv/
dist/
node_modules/
*.vsix
out/
.vscode-test/
.pytest_cache/

# packaging/build.ps1 output — regenerated by PyInstaller, never committed.
# packaging/assets/icon.ico IS committed (generated once from the VS Code
# extension's icon.png, and cheap to keep so a build doesn't need Pillow
# unless the source artwork actually changes).
packaging/build/

# The bundled Coach service executable — regenerated by
# packaging/build_vscode_service.ps1, too large (and too platform-specific)
# for git history. Built fresh before `vsce package` produces a .vsix.
vscode-extension/bundled/

# Local/runtime/secret-shaped files — never intended to be committed.
.env
*.env
*.log
*.db
coach.db
service.json
*.pem
*.key
*credential*
*secret*
*.local
