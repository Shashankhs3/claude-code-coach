# out/*.js (the compiled extension) and bundled/** (the bundled Coach
# service executable — see packaging/build_vscode_service.ps1) need to
# ship. Everything below is development-only and must never end up in the
# .vsix. bundled/** is deliberately NOT excluded here — vsce includes
# anything not listed, and this is the one binary this package actually
# needs at runtime.

.vscode-test/**
.vscode/**
src/**
out/test/**
**/*.map
**/*.ts
tsconfig.json
package-lock.json
node_modules/**
media/screenshots/**
.gitignore
**/.eslintrc.json
**/*.vsix
